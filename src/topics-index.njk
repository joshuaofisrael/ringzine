<p>These pages group RingZine coverage by promotion. Every story is labelled Confirmed or Rumor, and the sources live on the article. RingZine is independent and is not affiliated with WWE or AEW.</p>
<ul class="story-list">
{% for item in site.categories %}
  {% set stories = collections.posts | whereCategory(item.name) %}
  <li>
    <article class="story">
      <div class="story-copy">
        <p class="kicker">{{ stories.length }} {{ "story" if stories.length == 1 else "stories" }}</p>
        <h2 class="story-title"><a href="{{ ('/topics/' ~ item.slug ~ '/') | url }}">{{ item.name }}</a></h2>
        <p class="deck">{{ item.hubIntro }}</p>
      </div>
    </article>
  </li>
{% endfor %}
</ul>
